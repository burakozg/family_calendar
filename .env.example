# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Anthropic API key — powers the AI features (meal planning, recipe
# extraction/import, unit normalization, aisle tagging).
# The calendar itself works without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — OpenAI API key. Only needed if you pick an OpenAI (GPT) model in
# the admin AI settings; Claude models use ANTHROPIC_API_KEY above.
OPENAI_API_KEY=sk-...

# Optional — Mistral API key. Only needed if you pick a Mistral model
# (Ministral / Mistral Small / Large / Medium) in the admin AI settings.
MISTRAL_API_KEY=...

# Optional — OpenRouter API key (openrouter.ai). One key and one bill for models
# from every lab; needed for the models marked "(OpenRouter)" in the admin AI
# settings — Gemini, Qwen, Grok, and Claude Sonnet without an Anthropic key.
OPENROUTER_API_KEY=sk-or-...

# Optional — cloud shopping relay (see shopping-relay/README.md):
# SHOP_RELAY_URL=https://your-relay.fly.dev
# SHOP_RELAY_PUBLISH_TOKEN=<long random token, matches the relay's PUBLISH_TOKEN>
# SHOP_RELAY_POLL_SECONDS=90
# EMBED_ORIGIN=https://your-relay.fly.dev   # relay origin allowed to iframe this app (AI content tab; see HOME_HTTPS_SETUP.md)

# Optional — relay app "Home" tab (embedded mobile.html over your LAN HTTPS proxy):
# ALLOWED_HOSTS=localhost,home.example.duckdns.org   # hostnames allowed in the Host header

# Optional — mailbox.org mail/calendar sync (see MAILSYNC_DESIGN.md).
# Setup: create an alias (Settings → E-mail Addresses), a dedicated calendar
# (copy its CalDAV URL from calendar ☰ → Properties), and an app password if
# 2FA is on. Then enable + configure invitees in the admin Settings page.
# MAILSYNC_ADDRESS=family-alias@mailbox.org
# MAILSYNC_LOGIN=account@mailbox.org
# MAILSYNC_PASSWORD=<account or app password (Mail scope)>
# MAILSYNC_CALDAV_URL=https://dav.mailbox.org/caldav/<calendar-id>/
# MAILSYNC_POLL_SECONDS=120
#
# mailbox.org app passwords are scoped — a Mail-scope password won't work for
# CalDAV. If mail and calendar need different passwords, set these too
# (they default to MAILSYNC_LOGIN / MAILSYNC_PASSWORD when unset):
# MAILSYNC_CALDAV_PASSWORD=<app password with Calendar/DAV scope>
# MAILSYNC_CALDAV_LOGIN=<only if the DAV login differs from MAILSYNC_LOGIN>

# Optional — hobby Obsidian vault sync (recipes -> Recipes/, events/birthdays
# -> Calendar/). Same CouchDB server the vault already runs on, database
# `hobby` — see homelab/README.md. Unset (VAULT_COUCHDB_URL empty) means the
# sync loop never starts.
# VAULT_COUCHDB_URL=http://couchdb.local:5984
# VAULT_DB=hobby
# VAULT_USER=family_calendar
# VAULT_COUCHDB_PASSWORD=<the family_calendar member account's password>
# VAULT_SYNC_POLL_SECONDS=120
