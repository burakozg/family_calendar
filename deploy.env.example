# Copy to .deploy.env and fill in your real values. .deploy.env is git-ignored —
# never commit it. ./deploy auto-sources it if present, so these never need to be
# exported by hand each session. See homelab/README.md for the contract these
# names follow across the four NAS projects.

# ssh destination for the NAS host itself (NOT the app container). It must be the
# account that OWNS $NAS_APP_DIR — ./deploy writes backend/, frontend/, and .env
# there, and a NAS account that merely has shell access can read those but not
# write them. Give it a key (ssh-copy-id -p $NAS_SSH_PORT $NAS_SSH); with password
# auth every step prompts, and hangs rather than prompting when nothing can type.
NAS_SSH=admin@nas.local
NAS_SSH_PORT=22

# The app container's own static IP on the qnet bridge (see docker-compose.nas.yml).
# A different thing from NAS_SSH above — this one is a container, not the NAS.
# (Was NAS_HOST. That name meant the ssh destination in the sibling projects, so
# it is now rejected outright rather than silently misread.)
APP_LAN_IP=10.0.0.2
APP_PORT=8000

# The Caddy proxy's static IP on the same bridge (./deploy proxy track only).
# The DuckDNS A record must point here, or nothing on the LAN reaches the proxy.
PROXY_LAN_IP=10.0.0.3

# Optional — only needed if your NAS app directories aren't named to match
# this repo (defaults below match what ./deploy assumes if unset).
# NAS_APP_DIR=/share/Container/family-calendar
# PROXY_ROOT=/share/Container/family-calendar-proxy
